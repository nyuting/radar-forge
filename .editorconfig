# https://editorconfig.org — keeps whitespace consistent across editors before
# ruff ever runs. Supported natively by VS Code (with the EditorConfig
# extension), PyCharm, Vim and Emacs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown; do not eat it.
trim_trailing_whitespace = false
max_line_length = 100

[Makefile]
# Make requires real tabs for recipe lines.
indent_style = tab

[*.{sh,bash}]
indent_size = 4

[*.ipynb]
indent_size = 1
