#!/usr/bin/env bash
# Push gate: lint, types, conventions and the fast tests (everything not marked
# slow). CI runs the full suite, slow tests included, on every pull request.
# Order is cheapest-first so a formatting slip fails in a second, not a minute.

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
. "${HOOK_DIR}/_lib.sh"
# Scripts come from the checkout being committed or pushed, not from wherever
# core.hooksPath points: an absolute hooksPath would otherwise check main's
# files from inside a worktree.
ROOT="$(git rev-parse --show-toplevel)"

REMOTE_NAME="${1:-origin}"
ZERO='0000000000000000000000000000000000000000'

# git feeds refs on stdin as: <local ref> <local sha> <remote ref> <remote sha>
HAS_WORK=0
while read -r local_ref local_sha remote_ref _remote_sha; do
    # Branch deletions have nothing to test.
    [ "$local_sha" = "$ZERO" ] && continue
    HAS_WORK=1

    if [ "$remote_ref" = "refs/heads/main" ] && [ "${RADAR_FORGE_ALLOW_MAIN_PUSH:-0}" != "1" ]; then
        fail "Direct push to main on '$REMOTE_NAME' (from $local_ref)." \
             "Open a branch and a pull request instead:" \
             "  git switch -c feat/<short-name> && git push -u $REMOTE_NAME HEAD" \
             "" \
             "Solo maintenance escape hatch:" \
             "  RADAR_FORGE_ALLOW_MAIN_PUSH=1 git push"
    fi
done

[ "$HAS_WORK" = "0" ] && exit 0

require_uv
say "running the push gate (lint → types → conventions → fast tests)…"

uv run ruff format --check . >/dev/null || fail \
    "Repository is not formatted." "Fix:  make fmt"
ok "ruff format"

uv run ruff check . || fail \
    "Ruff found lint errors." "Fix what is auto-fixable:  make fmt"
ok "ruff check"

uv run mypy || fail \
    "mypy found type errors." \
    "Public functions need complete annotations; see docs/conventions/style.md."
ok "mypy"

uv run python "${ROOT}/scripts/check_conventions.py" || exit 1

if ! uv run pytest -m "not slow" -q; then
    fail "The fast test suite failed." \
         "Re-run it directly:  make test-fast" \
         "CI also runs the slow tests; run them locally with:  make test"
fi
ok "pytest (not slow)"

say "${GREEN}all checks passed${RESET} — pushing."
